{
  "name": "vcard-qrcode-generator",
  "version": "1.2.0",
  "description": "完全離線的 vCard 3.0 QRCode 產生器：左側輸入聯絡資料，右側即時預覽 QRCode",
  "main": "main.js",
  "private": true,
  "license": "MIT",
  "author": "zzx789654",
  "scripts": {
    "start": "electron .",
    "test": "node test/run-tests.js",
    "verify": "node test/verify-qr-decode-node.js",
    "build": "electron-builder --win --x64",
    "build:portable": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "^43.7.8",
    "electron-builder": "^26.17.0"
  },
  "overrides": {
    "global-agent": "^4.1.3"
  },
  "build": {
    "appId": "com.local.vcard.qrcode",
    "productName": "vCard QRCode Generator",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/icon.png"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
